# M5Stack CoreS3 overlay; apply after sdkconfig.defaults.esp32s3:
#   -DSDKCONFIG_DEFAULTS="sdkconfig.defaults.esp32s3;sdkconfig.defaults.esp32s3-cores3"
CONFIG_ESP_SDR_LCD_VIEW=y
CONFIG_ESP_SDR_LCD_BOARD_CORES3=y
# The board has 16 MB of flash; the 2 MB image layout is kept.
# Static data must stay below the RF ring at 0x3fcb0000 (sram_guard.ld), and
# IRAM code pushes DRAM up. The LCD path does not need IRAM-safe drivers:
# it never draws or reads touch during flash writes or while a capture
# masks interrupts.
# CONFIG_SPI_MASTER_ISR_IN_IRAM is not set
# CONFIG_SPI_SLAVE_ISR_IN_IRAM is not set
# CONFIG_ESP_SPI_BUS_LOCK_ISR_FUNCS_IN_IRAM is not set
# CONFIG_GDMA_CTRL_FUNC_IN_IRAM is not set
# CONFIG_GDMA_ISR_HANDLER_IN_IRAM is not set
# CONFIG_I2C_MASTER_ISR_HANDLER_IN_IRAM is not set
# Keep the 32 KB data cache: the 16 KB returned by a smaller one is reached
# through the cache, and SPI DMA descriptors placed there fail to sync.
